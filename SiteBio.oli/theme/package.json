{
    "name": "sitebio-theme",
    "version": "1.0.0",
    "private": true,
    "description": "Tema do SiteBio (baseado em Start Bootstrap - Business Casual, MIT). Compila o SCSS para app/static/css/styles.css",
    "scripts": {
        "build:css": "sass --load-path=node_modules --quiet --style=compressed --no-source-map scss/styles.scss ../app/static/css/styles.css",
        "watch:css": "sass --load-path=node_modules --quiet --watch --no-source-map scss/styles.scss ../app/static/css/styles.css"
    },
    "dependencies": {
        "bootstrap": "5.2.3"
    },
    "devDependencies": {
        "sass": "^1.69.0"
    }
}
