# Copie este arquivo para .env e preencha os valores locais. NUNCA envie o .env para o GitHub/ZIP.
SITEBIO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
SITEBIO_ADMIN_CODIGO=troque-este-codigo-de-administrador
SITEBIO_DATABASE_URL=mysql+pymysql://root:@localhost/sitebio
SITEBIO_COOKIE_SECURE=0

# SMTP é opcional durante o desenvolvimento.
SITEBIO_SMTP_HOST=
SITEBIO_SMTP_PORT=587
SITEBIO_SMTP_USUARIO=
SITEBIO_SMTP_SENHA=
SITEBIO_EMAIL_REMETENTE=
